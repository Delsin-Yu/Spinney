.vscode/**
.vscode-test/**
tools/**
# The remote-control side: the relay (C#) and the Android app live here. Neither
# is part of the extension package — the .vsix ships only the TypeScript host,
# the webviews and the user manual.
remote/**
.spinney/**
.agent-harness/**
.github/**
src/**
node_modules/**
.gitignore
.gitattributes
AGENTS.md
tsconfig.json
**/*.map
**/*.ts
build-deploy.ps1
docs/**
# Repository art for the README (screenshots). It never ships: the Marketplace reads
# the README from the repository, and vsce rewrites a relative image path to its raw
# URL, so the file is fetched, not packaged.
assets/**
*.vsix
# The collected build artifacts. The extension is packaged *into* this directory, so
# without this line the previous package would be swept into the next one.
artifacts/**
