{
  "name": "spinney",
  "displayName": "Spinney",
  "description": "%description%",
  "version": "0.7.1",
  "publisher": "DE-YU",
  "license": "MIT",
  "author": {
    "name": "Delsin-Yu",
    "url": "https://github.com/Delsin-Yu"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Delsin-Yu/Spinney.git"
  },
  "bugs": {
    "url": "https://github.com/Delsin-Yu/Spinney/issues"
  },
  "homepage": "https://github.com/Delsin-Yu/Spinney#readme",
  "icon": "media/icon.png",
  "keywords": [
    "agent",
    "agent harness",
    "ai coding agent",
    "deepseek",
    "branching",
    "subagent",
    "chat tree",
    "vscode extension"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:spinney.chatTree",
    "onWebviewPanel:spinney.modelTree"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spinney",
          "title": "Spinney",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "spinney": [
        {
          "id": "spinney.sessions",
          "name": "%view.sessions.name%",
          "contextualTitle": "Spinney"
        }
      ]
    },
    "commands": [
      {
        "command": "spinney.openSession",
        "title": "%command.spinney.openSession.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "spinney.newSession",
        "title": "%command.spinney.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "spinney.renameSession",
        "title": "%command.spinney.renameSession.title%",
        "icon": "$(edit)"
      },
      {
        "command": "spinney.autoRenameSession",
        "title": "%command.spinney.autoRenameSession.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "spinney.copySessionId",
        "title": "%command.spinney.copySessionId.title%",
        "icon": "$(copy)"
      },
      {
        "command": "spinney.deleteSession",
        "title": "%command.spinney.deleteSession.title%",
        "icon": "$(trash)"
      },
      {
        "command": "spinney.deleteBranch",
        "title": "%command.spinney.deleteBranch.title%",
        "icon": "$(trash)"
      },
      {
        "command": "spinney.openModelCards",
        "title": "%command.spinney.openModelCards.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "spinney.clear",
        "title": "%command.spinney.clear.title%"
      },
      {
        "command": "spinney.showSystemPrompt",
        "title": "%command.spinney.showSystemPrompt.title%"
      },
      {
        "command": "spinney.showRequestPayload",
        "title": "%command.spinney.showRequestPayload.title%"
      },
      {
        "command": "spinney.openGlobalAgentsMd",
        "title": "%command.spinney.openGlobalAgentsMd.title%"
      },
      {
        "command": "spinney.showManual",
        "title": "%command.spinney.showManual.title%"
      },
      {
        "command": "spinney.setApiKey",
        "title": "%command.spinney.setApiKey.title%"
      },
      {
        "command": "spinney.clearApiKey",
        "title": "%command.spinney.clearApiKey.title%"
      },
      {
        "command": "spinney.exportData",
        "title": "%command.spinney.exportData.title%"
      },
      {
        "command": "spinney.importData",
        "title": "%command.spinney.importData.title%"
      },
      {
        "command": "spinney.openDiagnosticsLog",
        "title": "%command.spinney.openDiagnosticsLog.title%"
      },
      {
        "command": "spinney.reloadChatWebview",
        "title": "%command.spinney.reloadChatWebview.title%"
      },
      {
        "command": "spinney.findInConversation",
        "title": "%command.spinney.findInConversation.title%"
      },
      {
        "command": "spinney.findInAllSessions",
        "title": "%command.spinney.findInAllSessions.title%"
      },
      {
        "command": "spinney.testWebSearchBackends",
        "title": "%command.spinney.testWebSearchBackends.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spinney.newSession",
          "when": "view == spinney.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "spinney.openSession",
          "when": "view == spinney.sessions",
          "group": "inline"
        },
        {
          "command": "spinney.deleteSession",
          "when": "view == spinney.sessions",
          "group": "inline"
        },
        {
          "command": "spinney.renameSession",
          "when": "view == spinney.sessions",
          "group": "1_modification@1"
        },
        {
          "command": "spinney.autoRenameSession",
          "when": "view == spinney.sessions",
          "group": "1_modification@2"
        },
        {
          "command": "spinney.copySessionId",
          "when": "view == spinney.sessions",
          "group": "2_copy"
        }
      ]
    },
    "configuration": [
      {
        "title": "%spinney.config.model.title%",
        "properties": {
          "spinney.model": {
            "type": "string",
            "default": "deepseek-flash",
            "markdownDescription": "%spinney.model.description%",
            "scope": "window"
          },
          "spinney.providers": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.providers.name.description%"
                },
                "baseUrl": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.providers.baseUrl.description%"
                },
                "concurrency": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0,
                  "description": "%spinney.providers.concurrency.description%"
                },
                "balance": {
                  "type": "string",
                  "enum": [
                    "none",
                    "deepseek",
                    "openrouter",
                    "moonshot"
                  ],
                  "default": "none",
                  "description": "%spinney.providers.balance.description%"
                },
                "sessionHeader": {
                  "type": "string",
                  "enum": [
                    "none",
                    "opencode"
                  ],
                  "default": "none",
                  "description": "%spinney.providers.sessionHeader.description%"
                }
              }
            },
            "markdownDescription": "%spinney.providers.markdownDescription%",
            "scope": "window"
          },
          "spinney.modelCards": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.modelCards.name.description%"
                },
                "providerId": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.modelCards.providerId.description%"
                },
                "oaiModel": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.modelCards.oaiModel.description%"
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1048576,
                  "description": "%spinney.modelCards.contextWindow.description%"
                },
                "concurrency": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0,
                  "description": "%spinney.modelCards.concurrency.description%"
                },
                "vision": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "%spinney.modelCards.vision.enabled.description%"
                    },
                    "transport": {
                      "type": "string",
                      "enum": [
                        "openai",
                        "deepseek"
                      ],
                      "default": "openai",
                      "description": "%spinney.modelCards.vision.transport.description%"
                    }
                  }
                },
                "efforts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "%spinney.modelCards.efforts.description%"
                },
                "defaultEffort": {
                  "type": "string",
                  "default": "",
                  "description": "%spinney.modelCards.defaultEffort.description%"
                }
              }
            },
            "markdownDescription": "%spinney.modelCards.markdownDescription%",
            "scope": "window"
          }
        }
      },
      {
        "title": "%spinney.config.chat.title%",
        "properties": {
          "spinney.replyLanguage": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "en",
              "zh-Hans",
              "zh-Hant",
              "ja",
              "ko",
              "es",
              "pt-br",
              "fr",
              "de",
              "ru",
              "it",
              "pl",
              "tr",
              "cs",
              "hu",
              "bg"
            ],
            "enumDescriptions": [
              "Follow the VS Code display language.",
              "English",
              "Simplified Chinese",
              "Traditional Chinese",
              "Japanese",
              "Korean",
              "Spanish",
              "Brazilian Portuguese",
              "French",
              "German",
              "Russian",
              "Italian",
              "Polish",
              "Turkish",
              "Czech",
              "Hungarian",
              "Bulgarian"
            ],
            "description": "%spinney.replyLanguage.description%",
            "scope": "window"
          },
          "spinney.promptSections": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "string"
            },
            "markdownDescription": "%spinney.promptSections.markdownDescription%",
            "scope": "window"
          },
          "spinney.streamAnimation": {
            "type": "boolean",
            "default": true,
            "description": "%spinney.streamAnimation.description%",
            "scope": "window"
          }
        }
      },
      {
        "title": "%spinney.config.tools.title%",
        "properties": {
          "spinney.execForegroundSeconds": {
            "type": "number",
            "default": 30,
            "minimum": 10,
            "maximum": 999999999999,
            "description": "%spinney.execForegroundSeconds.description%",
            "scope": "window"
          },
          "spinney.subAgentSyncSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 30,
            "maximum": 1800,
            "description": "%spinney.subAgentSyncSeconds.description%",
            "scope": "window"
          },
          "spinney.sessionMaxRounds": {
            "type": "number",
            "default": 16,
            "minimum": 1,
            "maximum": 64,
            "description": "%spinney.sessionMaxRounds.description%",
            "scope": "window"
          },
          "spinney.maxInlineToolOutput": {
            "type": "number",
            "default": 32768,
            "description": "%spinney.maxInlineToolOutput.description%",
            "scope": "window"
          },
          "spinney.searchTimeoutSeconds": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 600,
            "description": "%spinney.searchTimeoutSeconds.description%",
            "scope": "window"
          }
        }
      },
      {
        "title": "%spinney.config.subAgents.title%",
        "properties": {
          "spinney.maxConcurrentSubagents": {
            "type": "number",
            "default": 15,
            "description": "%spinney.maxConcurrentSubagents.description%",
            "scope": "window"
          },
          "spinney.maxLevel2Subagents": {
            "type": "number",
            "default": 2,
            "description": "%spinney.maxLevel2Subagents.description%",
            "scope": "window"
          }
        }
      },
      {
        "title": "%spinney.config.sessions.title%",
        "properties": {
          "spinney.autoSessionTitles": {
            "type": "boolean",
            "default": true,
            "description": "%spinney.autoSessionTitles.description%",
            "scope": "window"
          },
          "spinney.saveSessionTranscripts": {
            "type": "boolean",
            "default": true,
            "description": "%spinney.saveSessionTranscripts.description%",
            "scope": "window"
          },
          "spinney.saveSubAgentTranscripts": {
            "type": "boolean",
            "default": true,
            "description": "%spinney.saveSubAgentTranscripts.description%",
            "scope": "window"
          },
          "spinney.subAgentTranscriptDir": {
            "type": "string",
            "default": "",
            "description": "%spinney.subAgentTranscriptDir.description%",
            "scope": "window"
          },
          "spinney.dataDir": {
            "type": "string",
            "default": "",
            "description": "%spinney.dataDir.description%",
            "scope": "window"
          }
        }
      },
      {
        "title": "%spinney.config.controlPlane.title%",
        "properties": {
          "spinney.httpApi.enabled": {
            "type": "boolean",
            "default": false,
            "description": "%spinney.httpApi.enabled.description%",
            "scope": "window"
          },
          "spinney.httpApi.port": {
            "type": "number",
            "default": 0,
            "description": "%spinney.httpApi.port.description%",
            "scope": "window"
          },
          "spinney.diagnostics.log": {
            "type": "boolean",
            "default": true,
            "description": "%spinney.diagnostics.log.description%",
            "scope": "window"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && npm run sync:l10n",
    "sync:l10n": "node tools/sync-l10n-aliases.js",
    "clean:l10n": "node tools/sync-l10n-aliases.js --clean",
    "package": "vsce package && node tools/collect-artifacts.mjs --vsix --strict && npm run clean:l10n",
    "artifacts": "node tools/collect-artifacts.mjs",
    "check:models": "node tools/check-models.js",
    "check:highlight": "node tools/check-highlight.js",
    "check:webview": "node tools/check-webview.js",
    "check:mention": "node tools/check-mention.js",
    "check:modeltree": "node tools/check-modeltree.js",
    "check:signals": "node tools/check-signal-persist.js",
    "check:rollover": "node tools/check-context-rollover.js",
    "check:compaction": "node tools/check-compaction.js",
    "check:continue": "node tools/check-continue.js",
    "check:payload": "node tools/check-payload.js",
    "check:search": "node tools/search-files-acceptance.js",
    "check:l10n": "node tools/check-l10n.js",
    "check:grid": "node tools/check-tree-grid.js",
    "check:docs": "node tools/check-docs.js",
    "check:titles": "node tools/check-titles.js",
    "check:neterror": "node tools/check-neterror.js",
    "check:unicode": "node tools/check-unicode.js",
    "check:cwd": "node tools/exec-cwd-acceptance.js",
    "check:args": "node tools/args-acceptance.js",
    "check:shell": "node tools/shell-argv-acceptance.js",
    "check:kill": "node tools/exec-kill-acceptance.js",
    "check:exec": "node tools/exec-runtime-acceptance.js",
    "check:dock": "node tools/dock-acceptance.js",
    "check:websearch": "node tools/websearch-acceptance.js",
    "check:png": "node tools/check-png.js",
    "check:resample": "node tools/check-resample.js",
    "check:image": "node tools/check-png.js && node tools/check-resample.js && node tools/check-image.js && node tools/check-jpeg.js",
    "check:jpeg": "node tools/check-jpeg.js",
    "check:find": "node tools/find-acceptance.js",
    "sim": "node tools/sim/run.mjs",
    "sim:selftest": "node tools/sim/run.mjs --selftest",
    "vscode:prepublish": "npm run compile && npm run sync:l10n && npm run check:models && npm run check:highlight && npm run check:webview && npm run check:mention && npm run check:modeltree && npm run check:signals && npm run check:l10n && npm run check:rollover && npm run check:compaction && npm run check:grid && npm run check:docs && npm run check:titles && npm run check:cwd && npm run check:args && npm run check:search && npm run check:shell && npm run check:kill && npm run check:exec && npm run check:dock && npm run check:websearch && npm run check:image && npm run check:neterror && npm run check:unicode && npm run check:continue && npm run check:payload && npm run check:find"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
