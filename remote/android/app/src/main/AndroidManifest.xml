<?xml version="1.0" encoding="utf-8"?>
<!--
  Spinney Remote — the Android controller (milestone M3).

  TWO permissions, and the reason each one is here. `INTERNET` is the connection: every frame of the
  room is sealed before it is posted (§4), and the token never leaves the phone. `CAMERA` is the
  pairing gesture — point the phone at the desktop's screen and the room's code is read live
  (`CameraScanScreen`), refused with a sentence if the user declines, which leaves the system photo
  picker as the way in. There is no storage permission and no location: the picker hands back one
  URI without granting access to the gallery, and the camera frames are read in memory and dropped.

  `uses-feature camera` is deliberately `required="false"`: a phone without a camera still pairs
  through the picker, and the manifest must not keep it out of the app's reach.

  `usesCleartextTraffic` is on because a relay is self-hosted and `remote/PROTOCOL.md` §7 says
  "plain HTTP(S)" — a developer's relay on a LAN is usually `http://`. It is a deliberate,
  visible choice rather than a hidden fallback: the token never leaves the phone (it is not sent
  to the relay at all, §3), and every frame is sealed before it is posted.

  `hardwareAccelerated` and the WebView are the session view: the shipped `media/main.js` renders
  the same tree a VS Code window renders, and it needs a real compositor.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:label="Spinney Remote"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
