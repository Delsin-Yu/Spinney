# Dependencies
node_modules/

# Build output
out/
dist/
# ...except the vendored, hash-pinned engine's published dist: that is source for
# this repo, not build output (docs/agents/invariants/vendored-deps.md).
!media/vendor/*/dist/
!media/vendor/*/dist/**

# Packaged VS Code extension
*.vsix

# Generated, never committed: the reported-tag copies of the l10n catalogs, which
# VS Code reads by the tag it reports rather than by the canonical one the repo
# authors. `npm run sync:l10n` writes them for the length of a package run and
# `--clean` removes them again (docs/agents/invariants/i18n.md); the entries here
# are the net that catches a leftover after an interrupted one.
package.nls.zh-cn.json
package.nls.zh-tw.json
l10n/bundle.l10n.zh-cn.json
l10n/bundle.l10n.zh-tw.json

# Test / coverage
.vscode-test/
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Transcript dumps (one API message per line) written by the agent
*.jsonl

# OS
.DS_Store
Thumbs.db

# Hyper-Vscode supervisor state (daemon token, logs, isolated profiles)
tools/hyper-vscode/.state/

# Agent scratch space (screenshots, spilled tool output)
.spinney/
# pre-rename scratch dir, kept ignored so an older checkout stays clean
.agent-harness/
