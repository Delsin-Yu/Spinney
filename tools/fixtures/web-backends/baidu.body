  height: 18px;
  margin-right: 6px;
  flex-shrink: 0;
}
.bdsug-clear-history-toast-content {
  flex-shrink: 0;
  text-align: center;
  font-size: 13px;
  line-height: 18px;
  white-space: nowrap;
}
