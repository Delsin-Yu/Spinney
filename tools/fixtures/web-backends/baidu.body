.bdsug-clear-confirm-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.15);
}
.bdsug-clear-confirm-dialog {
  box-sizing: border-box;
  width: 360px;
  padding: 21px;
  background-color: #fff;
  border-radius: 14px;
  box-shadow: 0 6px 21px 0 rgba(30, 31, 36, 0.12);
  color: #333333;
  text-align: left;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.bdsug-clear-confirm-title {
  display: flex;
  align-items: center;
  font-size: 18px;
  font-weight: 500;
  line-height: 18px;
}
.bdsug-clear-confirm-title svg {
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  margin-right: 6px;
}
.bdsug-clear-confirm-desc {
  margin: 5px 0 -5px;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
  color: #50525c;
}
.bdsug-clear-confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 15px;
  margin-top: 15px;
}
.bdsug-clear-confirm-btn {
  box-sizing: border-box;
  width: 80px;
  height: 30px;
  padding: 0;
  border: none;
  border-radius: 18px;
  font-size: 13px;
  font-weight: 400;
  line-height: 30px;
  cursor: pointer;
}
.bdsug-clear-confirm-btn-cancel {
  color: #4e6ef2;
  background-color: #e8f3ff;
}
.bdsug-clear-confirm-btn-ok {
  color: #fff;
  background-color: #4e6ef2;
}
.bdsug-clear-history-toast {
  position: fixed;
  top: 15px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 902;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 42px;
  padding: 12px 15px;
  background-color: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 21px 0 rgba(30, 31, 36, 0.2);
  color: #333333;
  pointer-events: none;
}
.bdsug-clear-history-toast svg {
