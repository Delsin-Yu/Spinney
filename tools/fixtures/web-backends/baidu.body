  position: absolute;
  font-size: 14px;
  bottom: 38px;
  transition: opacity 240ms ease-in-out;
  left: 50%;
  transform: translateX(-50%);
  width: 88px;
  height: 30px;
  z-index: 10;
  border-radius: 15px;
  background: #000000CC;
  color: #FFFFFF;
