8/67601248","srcid":1547,"tplName":"bk_polysemy","ext":"{\"baike_id\":\"67601248\",\"source\":\"baike\",\"lid\":\"9a08523b0025a685\",\"title\":\"deepseek%E7%BD%91%E9%A1%B5%E7%89%88\",\"url\":\"https%3A%2F%2Fbaike.baidu.com%2Fitem%2FDeepSeek%25E7%25BD%2591%25E9%25A1%25B5%25E7%2589%2588%2F67601248\"}","extId":"139c3043d7423c0a86ddd1d9c68dd54b"},"ariaData":{"ariaTitle":"deepseek网页版，杭州深度求索人工智能基础技术研究有限公司开发的DeepSeek AI模型的官方网页端服务，百度百科","ariaBrief":"DeepSeek网页版是杭州深度求索人工智能基础技术研究有限公司开发的DeepSeek AI模型的官方网页端服务，用户无需安装任何软件，通过浏览器访问其官方页面即可使用。2026年3月29日，DeepSeek网页版发生长时间服务中断，恢复后用户报告其模型能力有所提升。2026年4月6日，官方发布DeepSeek-V3.2正式版，该版本强化了Agent能力并在网页端上线。同年4月8日，网页版对话界面更新，新增了“快速模式”和“专家模式”选项；其中专家模式新增了编程、法律、医学等领域的专业知识咨询能力，在数理问题处理上表现更优，其入口出现了类似“钻石”的标识，被外界猜测可能为未来的付费模式做准备，且该模式暂不支持文件上传；而视觉模式没有在此次更新中推出，有分析称其可能与具备多模态能力的未来版本一同发布。2026年4月24日，DeepSeek-V4预览版本正式上线并开源。2026年5月8日，De","ariaMedia":"播放视频","ariaControl":{"close":"关闭视频","replay":"重播视频","lemma":"进入百科"}},"$style":{"bk_polysemy":"bk_polysemy_1Ef6j","bkPolysemy":"bk_polysemy_1Ef6j","zk-title":"zk-title_gtNW1","zkTitle":"zk-title_gtNW1","icon":"icon_31fNO","card-normal":"card-normal_3X7DX","cardNormal":"card-normal_3X7DX","main-info":"main-info_4Q_kj","mainInfo":"main-info_4Q_kj","source":"source_1rJIg","left-image":"left-image_3TJlK","leftImage":"left-image_3TJlK","video-poster":"video-poster_3md57","videoPoster":"video-poster_3md57","video-logo":"video-logo_2HJcT","videoLogo":"video-logo_2HJcT","more-text":"more-text_1iBMJ","moreText":"more-text_1iBMJ","catalog-list":"catalog-list_iR5a4","catalogList":"catalog-list_iR5a4","catalog-group-item":"catalog-group-item_2Xyfb","catalogGroupItem":"catalog-group-item_2Xyfb","ellipsis":"ellipsis_efK7X","video-wrapper":"video-wrapper_MQNVE","videoWrapper":"video-wrapper_MQNVE","show":"show_1I1Pj","hide":"hide_1yagk","video-container":"video-container_XudHF","videoContainer":"video-container_XudHF","video-close-wrapper":"video-close-wrapper_RzqAs","videoCloseWrapper":"video-close-wrapper_RzqAs","close-text":"close-tex