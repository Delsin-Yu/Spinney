wXJViH_Fe6KG5dvY2UUL"},"ariaProps":{"fromAriaHidden":false,"fromAriaLabel":"百度百科","fromAriaTabIndex":0}},"ttsInfo":{"supportTts":true,"ttsSourceType":"default","titleUrl":"https://baike.baidu.com/item/%E6%9D%AD%E5%B7%9E%E6%B7%B1%E5%BA%A6%E6%B1%82%E7%B4%A2%E4%BA%BA%E5%B7%A5%E6%99%BA%E8%83%BD%E5%9F%BA%E7%A1%80%E6%8A%80%E6%9C%AF%E7%A0%94%E7%A9%B6%E6%9C%89%E9%99%90%E5%85%AC%E5%8F%B8/64541110?fromtitle=DeepSeek&fromid=65258669&fr=aladdin","srcid":37024,"tplName":"bk_polysemy","ext":"{\"baike_id\":\"64541110\",\"source\":\"baike\",\"lid\":\"9a08523b0025a685\",\"title\":\"deepseek\",\"url\":\"https%3A%2F%2Fbaike.baidu.com%2Fitem%2F%25E6%259D%25AD%25E5%25B7%259E%25E6%25B7%25B1%25E5%25BA%25A6%25E6%25B1%2582%25E7%25B4%25A2%25E4%25BA%25BA%25E5%25B7%25A5%25E6%2599%25BA%25E8%2583%25BD%25E5%259F%25BA%25E7%25A1%2580%25E6%258A%2580%25E6%259C%25AF%25E7%25A0%2594%25E7%25A9%25B6%25E6%259C%2589%25E9%2599%2590%25E5%2585%25AC%25E5%258F%25B8%2F64541110%3Ffromtitle%3DDeepSeek%26fromid%3D65258669%26fr%3Daladdin\"}","extId":"f5335da690eac2431a08011bb4830350"},"ariaData":{"ariaTitle":"deepseek，人工智能企业，百度百科","ariaBrief":"杭州深度求索人工智能基础技术研究有限公司（简称DeepSeek）2023年7月17日成立，总部位于浙江省杭州市，法定代表人为裴湉，由幻方量化创立，主营大语言模型及多模态AI技术研发。主营业务：公司以开源为核心运营策略，开放模型权重与技术报告，并通过API与开放平台向开发者提供服务；采用混合专家（MoE）等高效架构，实现低成本的模型训练与推理。主要产品：公司推出DeepSeek系列大语言模型，包括2024年1月首个DeepSeek LLM、2024年5月DeepSeek-V2、2024年12月DeepSeek-V3及2025年1月DeepSeek-R1等；并面向用户提供DeepSeek App智能助手与开放平台API服务。科研成果：DeepSeek-V3为自研MoE架构大模型，总参数671B，预训练成本约557.6万美元；DeepSeek-R1采用大规模强化学习后训练，性能对齐OpenAI ","ariaMedia":"播放视频","ariaControl":{"close":"关闭视频","replay":"重播视频","lemma":"进入百科"}},"$style":{"bk_polysemy":"bk_polysemy_1Ef6j","bkPolysemy":"bk_polysemy_1Ef6j","zk-title":"zk-title_gtNW1","zkTitle":"zk-title_gtNW1","icon":"icon_31fNO","card-normal":"card-normal_3X7DX","cardNormal":"card-normal_3X7DX","main-info":"main-info_4Q_kj","mainInfo":"main-info_4Q_kj","source":"source_1rJIg","left-image":"left-image_3TJlK","leftImage":"left-image_3TJlK","video-poster":"video-poster_3md57","vide